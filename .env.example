# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# LLM provider selection: mock | openai | anthropic | google
LLM_PROVIDER=mock

# OpenAI (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Google Generative AI (only needed when LLM_PROVIDER=google)
GOOGLE_API_KEY=

# Backend settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend settings (Vite reads VITE_ prefix)
VITE_API_URL=http://127.0.0.1:8000
